# Copy to .env for local use. Leave DATABASE_URL empty to use a local SQLite file.
SECRET_KEY=change-me-to-a-long-random-string
# Neon connection string (Dashboard > Connection details). Keep ?sslmode=require
DATABASE_URL=
# Set to false after you create your own account to stop public sign-ups
ALLOW_SIGNUP=true
# Public site URL used when building guest links, e.g. https://your-app.vercel.app
BASE_URL=
TIMEZONE=Asia/Kolkata
APP_NAME=Invitation Studio
